# ==============================================================================
# Sachithra Portfolio - Environment Configuration
# ==============================================================================
# ONLY MongoDB Atlas is used for both application data and binary file storage (GridFS).
# Cloudflare R2, AWS S3, and external object storage services are strictly removed.
# ==============================================================================

# MongoDB Atlas Connection String
# Includes database name, replica set, and write concern settings
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE

# Initial Admin Credentials (used by seeding scripts and initial setup)
ADMIN_EMAIL=sachithrai1003@gmail.com
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Session & JWT Encryption Secret (Must be a secure 32+ character random string)
# Generate via: openssl rand -base64 32
SESSION_SECRET=sachithra_portfolio_secure_session_secret_key_minimum_32_chars_long

# Canonical Public URL of the Portfolio (Used for metadata, OG images, and CORS)
NEXT_PUBLIC_SITE_URL=https://sachithraindrachapa.vercel.app
